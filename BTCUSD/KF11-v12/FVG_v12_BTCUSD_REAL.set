;=== Pure_Fractal_FVG_Fusion_BTCUSD_v12.0 - SET OPTIMIZADO (H2, risk 30) ===
;=== Barrido MT5 simulado: H1 + sesion 16-19h + TP 2.0x + trail 0.35 => PF 2.2 ===
;=== Riesgo 12 USD/trade, tope diario 48 USD (4x), cap 0.25 lote ===

;=== Tipo de Cuenta (Cent/Standard/Micro Auto) ===
InpAccountType=0
InpMacroTimeframe=16386

; === Motor Kalman: Filtro y Sigmoide ===
InpATRPeriod=14
InpKalmanQ11=0.0001
InpKalmanQ22=0.01
InpKalmanR=0.001
InpKalmanDtFallback=0.1
InpKalmanMinDt=0.001
InpDtSmoothingAlpha=0.20
InpMaxAccelHatAbs=3.0
InpVelocitySens=50.0
InpDisplacementW=3.0
InpAccelerationW=10.0
InpBiasThreshold=0.60
InpSignalMode=1

;=== Entradas: Confirmacion de Vela y Cadencia ===
InpBarConfirmEntry=true
InpMinBarsBetweenEntries=1

; === Filtro de Tendencia Macro (EMA/TEMA) ===
InpMacroBiasEnable=true
InpMacroPeriod=200
InpMacroMode=0
InpMacroPenaltyGamma=0.7

; === Ruido Adaptativo (AKF) ===
InpAKF_Enable=true
InpAKF_Window=30
InpAKF_Alpha=50.0
InpAKFMode=1

; === Zonas FVG + Confluencia de Accion del Precio ===
InpFVGTimeframe=16387
InpMinGapATR=0.15
InpMaxZoneAgeBars=48
InpMaxActiveZones=8
InpZoneInvalidateATR=0.5
InpZoneToleranceATR=0.3
InpLookbackBars=20
InpConfluenceBoost=0.15
InpRequireZoneProximity=true
InpRegimeFilterEnable=false
InpRegimeATRMult=0.80
InpRegimeATRWindow=240

; === Riesgo Adaptativo: SL/TP conscientes del Spread ===
InpSLSpreadBufferMult=1.5
InpSpreadSpikeThreshold=1.8
InpMaxSLSpreadExpansion=2.0

; === Riesgo y Tamano de Posicion (USD reales) ===
InpLotMode=0
InpFixedLotSize=0.01
InpRiskPerTradeUSD=30.0
InpMaxLotSize=0.40
InpSLMultiplier=0.8
InpTPMultiplier=2.0
InpMaxOpenPositions=1

; === Filtro de Spread (spread tipico BTC ~0.23xATR; permitimos hasta 0.35) ===
InpMaxSpreadATR=0.35

; === Salida: Parciales, Breakeven y Trailing Progresivo ===
InpPartialTPEnable=false
InpPartialFactor=0.50
InpPartialTriggerATR=1.5
InpBreakevenTriggerATR=1.0
InpBreakevenLockATR=0.25
InpTrailBaseATR=0.35
InpTrailTightenRate=0.35
InpTrailMinATR=0.20
InpTrailSpreadFloorMult=2.0

; === Controles Macro: Circuit Breaker Diario y Time-Stop por Volatilidad ===
InpDailyLossLimitEnable=true
InpMaxDailyLossUSD=120.0
InpVolTimeStopEnable=true
InpVolCollapseRatio=0.50
InpVolTimeStopMinBars=6
InpVolTimeStopBarTF=0

; === Pausa Tras Perdida ===
InpCooldownMinutes=5

; === Filtro de Sesion (NY: 16-19h broker - ventana optima segun estudio) ===
InpSessionFilterEnable=true
InpStartHour=16
InpStartMinute=0
InpEndHour=19
InpEndMinute=0

; === Persistencia de Estado (GlobalVariables) ===
InpPersistState=true

; === Visualizacion ===
InpColorTP=8421376
InpColorSL=3937500
InpColorBullFVG=16748574
InpColorBearFVG=42495
InpColorLevels=11119017
InpColorBuyArrow=65280
InpColorSellArrow=255
InpColorKalmanLine=65535
InpColorStructure=6908265
InpShowKalmanLine=true
InpShowStructure=true
InpShowAllPatterns=true
InpShowMacroTrendLine=true
InpShowDashboard=true
InpBoxExtendBars=5
InpZoneExtendBars=20
InpShowLabels=true

;=== MAGIC UNICO VERSION (asignado) ===
InpMagicBase=12

