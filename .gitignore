# Ignorar secretos y artefactos sensibles — NUNCA commitear credenciales.
# (Parte del ecosistema definido en el repo privado AI-Security-Guardrails)

# Archivos de entorno y secretos
*.env
.env
.env.*
*.env.local
*.env.*.local

# Claves y certificados
*.pem
*.key
*.keystore
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_ed25519
id_dsa
id_ecdsa
*.pub.gpg
secrets.json
credentials.json
credentials.yaml
config.secret.*

# Tokens / API keys sueltas
*.token
*.apikey
apikeys.txt
api_keys.txt

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencias y build
node_modules/
dist/
build/
__pycache__/
*.pyc

# Editor / SO
.vscode/
.idea/
.DS_Store
Thumbs.db
